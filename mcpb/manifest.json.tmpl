{
  "manifest_version": "0.3",
  "name": "privacyfence",
  "version": "__VERSION__",
  "description": "Privacy proxy between Claude and your personal data (Gmail, Drive, Slack, Calendar, Tasks, Contacts, Telegram, Salesforce, Jira, Confluence). Every read/write passes through an approval gate and an audit log before Claude sees or changes anything.",
  "long_description": "PrivacyFence connects Claude to your Gmail, Google Drive, Slack, Calendar, Tasks, Contacts, Telegram, Salesforce, Jira, and Confluence through a local daemon that owns all credentials and enforces per-tool auto-accept/review/popup gates, with every request written to an audit log.\n\nRequires the PrivacyFence app. This extension only connects Claude to it and does nothing on its own. Install the app for macOS, Windows or Linux from https://privacyfence.eu/download/ and connect the services you want in it, then install this extension. The macOS and Windows installers already include it.",
  "author": {
    "name": "Andras Takacs",
    "email": "info@privacyfence.eu"
  },
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "server/shim.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/shim.js"]
    }
  },
  "compatibility": {
    "runtimes": {
      "node": ">=20.0.0"
    }
  }
}
