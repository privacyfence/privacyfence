# PrivacyFence daemon systemd --user unit — Linux equivalent of
# com.privacyfence.app.plist, for a real (non-editable) `pip`/`pipx install
# privacyfence` (see CLAUDE.md's "Publishing to PyPI" section for how the
# package gets onto PyPI in the first place).
#
# The daemon has no native UI layer to import: `daemon_main.run_app()` ends
# by blocking on a plain threading.Event (`_wait_for_shutdown`), not by
# entering a macOS menu-bar run loop, so it runs the same on Linux. `rumps`
# and `pyobjc-framework-*` are not declared as dependencies of any kind
# (ADR 0001), and the daemon starts and runs headlessly in this repo's Linux
# CI legs (`.github/workflows/tests.yml`).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp privacyfence.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now privacyfence
#
# Uninstall:
#   systemctl --user disable --now privacyfence
#   rm ~/.config/systemd/user/privacyfence.service
#   systemctl --user daemon-reload
#
# Logs: journalctl --user -u privacyfence -f
#
# ExecStart assumes `pipx install privacyfence` (pipx's default bin
# location). Adjust if installed elsewhere (a plain `pip install --user`,
# or a dedicated venv).
#
# This unit runs the daemon as you, which is also who the AI client it
# governs runs as -- the weakness privilege separation exists to close.
# `sudo scripts/linux_privilege_separation.sh enable` runs it as a *system*
# unit instead (installer/linux/privacyfence-daemon.service.tmpl,
# /etc/systemd/system/privacyfence-daemon.service) under a dedicated
# `privacyfence` account, with its data in /var/lib/privacyfence. That script
# does not touch this unit or ~/.privacyfence: disable and remove this unit
# first (see Uninstall above), or it starts a second daemon in your session,
# which refuses to run on a separated install.

[Unit]
Description=PrivacyFence daemon
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/privacyfence-app
# Mirrors the plist's KeepAlive/SuccessfulExit=false: restart on a crash,
# not on a clean exit (e.g. `systemctl --user stop`).
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
