# PrivacyFence daemon systemd --user unit — Linux equivalent of
# com.privacyfence.app.plist, for a real (non-editable) `pip`/`pipx install
# privacyfence` (see CLAUDE.md's "Publishing to PyPI" section for how the
# package gets onto PyPI in the first place).
#
# ================================================================
# The specific blocker this comment used to describe -- `daemon_main.
# run_app()` unconditionally ending with `from .menu_bar import
# run_menu_bar; run_menu_bar(...)`, and `menu_bar.py` doing a bare `import
# rumps` (macOS AppKit) at module scope with no platform guard -- is fixed
# as of P10, decision D6: menu_bar.py and the rest of the native AppKit UI
# layer are deleted outright, not merely guarded, and run_app() now ends
# by blocking on a plain threading.Event (see that module's own
# `_wait_for_shutdown`).
# `rumps`/`pyobjc-framework-*` are optional extras now (pyproject.toml's
# `macos-native` group) that this install path never pulls in.
#
# Verified on a real Linux install: this systemd unit, a real `pipx install
# privacyfence`, and a live connector's OAuth flow (`webbrowser.open()`-based)
# have all been exercised end to end. Nothing in src/privacyfence/ imports a
# platform-specific module (grep for `sys.platform`/`darwin` turns up nothing
# outside this comment and its own history), and the daemon also starts and
# runs headlessly in this repo's own Linux CI leg (`.github/workflows/tests.yml`).
# ================================================================
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp privacyfence.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now privacyfence
#
# Uninstall:
#   systemctl --user disable --now privacyfence
#   rm ~/.config/systemd/user/privacyfence.service
#   systemctl --user daemon-reload
#
# Logs: journalctl --user -u privacyfence -f
#
# ExecStart assumes `pipx install privacyfence` (pipx's default bin
# location). Adjust if installed elsewhere (a plain `pip install --user`,
# or a dedicated venv).
#
# This unit runs the daemon as you, which is also who the AI client it
# governs runs as -- issue #428's whole subject. #428 Phase 4 (B5b) makes
# that opt-out-able: `sudo scripts/linux_privilege_separation.sh enable`
# replaces this with a *system* unit
# (installer/linux/privacyfence-daemon.service.tmpl,
# /etc/systemd/system/privacyfence-daemon.service) running under a dedicated
# `privacyfence` account, and moves this file to
# privacyfence.service.disabled so it cannot start a second daemon in your
# session at the next login. `... disable` puts it back. Nothing here changes
# unless you run that script.

[Unit]
Description=PrivacyFence daemon
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/privacyfence-app
# Mirrors the plist's KeepAlive/SuccessfulExit=false: restart on a crash,
# not on a clean exit (e.g. `systemctl --user stop`).
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
