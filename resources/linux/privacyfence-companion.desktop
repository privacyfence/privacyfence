[Desktop Entry]
Type=Application
Name=PrivacyFence
Comment=Open PrivacyFence's approvals and settings
Exec=/usr/bin/privacyfence-companion --action=open-approvals
Icon=privacyfence
Terminal=false
Categories=Utility;
Actions=Settings;RecoveryCode;ServiceStatus;StartService;RestartService;StopService;Quit;
# #428 Phase 3 (ADR 0002 decision 2): Linux's own "same menu items as the
# macOS/Windows tray" -- this entry (installed to /usr/share/applications/,
# not /etc/xdg/autostart/ -- see privacyfence.desktop's own comment) is a
# real, clickable Applications-menu item, unlike that autostart-only file.
# Each Exec= below runs privacyfence-companion --action=... once and exits
# (companion.py's own module docstring): there's no persistent Linux tray
# process for these to attach to, so every action here is one-shot.
#
# The local-mode-fixes plan's Phase 2: the four ServiceStatus/StartService/
# RestartService/StopService actions are this platform's counterpart to
# the macOS/Windows tray's dynamic status line and Start/Restart/Stop items -- ADR 0002
# decision 4 rules out a tray icon here, not the affordance itself, so
# Linux gets the same four actions as menu entries that show a zenity/
# kdialog dialog instead of updating a menu-bar item in place. Start/Stop
# are both offered unconditionally, unlike the tray's visibility toggle: a
# one-shot launcher has no running state of its own to hide either one
# behind, and running the wrong one (starting an already-running service,
# stopping an already-stopped one) is a no-op the platform script itself
# already handles.

[Desktop Action Settings]
Name=Settings
Exec=/usr/bin/privacyfence-companion --action=open-settings

[Desktop Action RecoveryCode]
Name=New PrivacyFence recovery code
Exec=/usr/bin/privacyfence-companion --action=recovery-code

[Desktop Action ServiceStatus]
Name=PrivacyFence service status
Exec=/usr/bin/privacyfence-companion --action=service-status

[Desktop Action StartService]
Name=Start PrivacyFence
Exec=/usr/bin/privacyfence-companion --action=service-start

[Desktop Action RestartService]
Name=Restart PrivacyFence
Exec=/usr/bin/privacyfence-companion --action=service-restart

[Desktop Action StopService]
Name=Stop PrivacyFence
Exec=/usr/bin/privacyfence-companion --action=service-stop

[Desktop Action Quit]
Name=Quit PrivacyFence
Exec=/usr/bin/privacyfence-companion --action=quit
