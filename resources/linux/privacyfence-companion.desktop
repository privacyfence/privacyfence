[Desktop Entry]
Type=Application
Name=PrivacyFence
Comment=Open PrivacyFence's approvals and settings
Exec=/usr/bin/privacyfence-companion --action=open-approvals
Icon=privacyfence
Terminal=false
Categories=Utility;
Actions=Settings;RecoveryCode;Quit;
# #428 Phase 3 (ADR 0002 decision 2): Linux's own "same menu items as the
# macOS/Windows tray" -- this entry (installed to /usr/share/applications/,
# not /etc/xdg/autostart/ -- see privacyfence.desktop's own comment) is a
# real, clickable Applications-menu item, unlike that autostart-only file.
# Each Exec= below runs privacyfence-companion --action=... once and exits
# (companion.py's own module docstring): there's no persistent Linux tray
# process for these to attach to, so every action here is one-shot.

[Desktop Action Settings]
Name=Settings
Exec=/usr/bin/privacyfence-companion --action=open-settings

[Desktop Action RecoveryCode]
Name=New PrivacyFence recovery code
Exec=/usr/bin/privacyfence-companion --action=recovery-code

[Desktop Action Quit]
Name=Quit PrivacyFence
Exec=/usr/bin/privacyfence-companion --action=quit
