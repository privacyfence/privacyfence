# Copy to privacyfence.env next to compose.yaml and edit. Compose reads it as the privacyfence
# service's environment (env_file); nothing here is needed when you run PrivacyFence on this
# computer for yourself.

# The public address people and AI clients use, with no path. It is also the address the identity
# provider redirects back to: register <this>/oauth/idp/callback, <this>/oauth/idp/login-callback
# and <this>/oauth/stepup/callback with the identity provider.
PRIVACYFENCE_ISSUER_URL=https://privacyfence.example.com

# The reverse proxy in front of PrivacyFence. The Caddy in compose.yaml has this address; without
# it PrivacyFence ignores X-Forwarded-For and X-Forwarded-Proto.
PRIVACYFENCE_TRUSTED_PROXIES=172.30.87.2

# The image listens on 0.0.0.0 inside its container and on port 8765. Change these only if you
# also change the Caddyfile.
# PRIVACYFENCE_BIND_HOST=0.0.0.0
# PRIVACYFENCE_PORT=8765

# The OIDC app registered with your identity provider. Both are needed; setting only one refuses
# the start.
PRIVACYFENCE_IDP_ISSUER=https://accounts.google.com
PRIVACYFENCE_IDP_CLIENT_ID=

# The client secret. Prefer the file form with a Docker secret (see the commented `secrets:` in
# compose.yaml): the value then does not show in `docker inspect`. Set one of the two, not both.
# PRIVACYFENCE_IDP_CLIENT_SECRET=
# PRIVACYFENCE_IDP_CLIENT_SECRET_FILE=/run/secrets/idp_client_secret

# Who is an administrator. Either name people by email (comma-separated; the identity provider
# must send email_verified), or name a group claim and its values.
# PRIVACYFENCE_ADMIN_EMAILS=alice@example.com,bob@example.com
# PRIVACYFENCE_IDP_ADMIN_GROUP_CLAIM=groups
# PRIVACYFENCE_IDP_ADMIN_GROUP_VALUES=privacyfence-admins

# Ask the identity provider for stronger authentication on step-up (comma-separated acr values).
# PRIVACYFENCE_IDP_STEP_UP_ACR_VALUES=

# Providers that never send email_verified (Microsoft Entra ID) can only use allowed email domains
# when this is "true". It never makes anyone an administrator.
# PRIVACYFENCE_IDP_TRUST_UNVERIFIED_EMAIL=false
