# Copy to privacyfence.env next to compose.yaml and edit. Compose reads it as the privacyfence
# service's environment (env_file); nothing here is needed when you run PrivacyFence on this
# computer for yourself.

# The server address and the proxy address are not set here: compose.yaml sets
# PRIVACYFENCE_ISSUER_URL to https://<PF_HOSTNAME from .env> and PRIVACYFENCE_TRUSTED_PROXIES to
# Caddy's address, and those win over this file. Register <server>/oauth/idp/callback,
# <server>/oauth/idp/login-callback and <server>/oauth/stepup/callback with your identity provider.

# The image listens on 0.0.0.0 inside its container and on port 8765. Change these only if you
# also change the Caddyfile.
# PRIVACYFENCE_BIND_HOST=0.0.0.0
# PRIVACYFENCE_PORT=8765

# The OIDC app registered with your identity provider. Both are needed; setting only one refuses
# the start.
PRIVACYFENCE_IDP_ISSUER=https://accounts.google.com
PRIVACYFENCE_IDP_CLIENT_ID=

# The client secret. Prefer the file form with a Docker secret (see the commented `secrets:` in
# compose.yaml): the value then does not show in `docker inspect`. Set one of the two, not both.
# PRIVACYFENCE_IDP_CLIENT_SECRET=
# PRIVACYFENCE_IDP_CLIENT_SECRET_FILE=/run/secrets/idp_client_secret

# Who is an administrator. Either name people by email (comma-separated; the identity provider
# must send email_verified), or name a group claim and its values.
# PRIVACYFENCE_ADMIN_EMAILS=alice@example.com,bob@example.com
# PRIVACYFENCE_IDP_ADMIN_GROUP_CLAIM=groups
# PRIVACYFENCE_IDP_ADMIN_GROUP_VALUES=privacyfence-admins

# Ask the identity provider for stronger authentication on step-up (comma-separated acr values).
# PRIVACYFENCE_IDP_STEP_UP_ACR_VALUES=

# Providers that never send email_verified (Microsoft Entra ID) can only use allowed email domains
# when this is "true". It never makes anyone an administrator.
# PRIVACYFENCE_IDP_TRUST_UNVERIFIED_EMAIL=false

# Built-in Google sign-in (opt-in), instead of the own-IdP block above. People sign in with
# PrivacyFence's own Google app through oauth.privacyfence.eu, so there is no app to register. It
# cannot be combined with your own IdP settings: comment out every PRIVACYFENCE_IDP_* line above
# (the issuer included) when you use it. Only the admins named here and people whose verified
# Google Workspace address is in an allowed domain can sign in; personal Google accounts cannot.
# The allowed domains seed Admin -> Sign-in on the first start and are edited there afterwards.
# PRIVACYFENCE_IDP=builtin-google
# PRIVACYFENCE_ADMIN_EMAILS=alice@example.com,bob@example.com
# PRIVACYFENCE_ALLOWED_DOMAINS=example.com

# Peek and Grist (optional). Give the server the addresses and the provisioning keys, then turn
# automatic accounts on under Admin -> Services. The keys are secrets: use the file form with a
# Docker secret (see the commented `secrets:` in compose.yaml), or set the plain variable
# PRIVACYFENCE_PEEK_PROVISIONING_KEY / PRIVACYFENCE_GRIST_PROVISIONING_KEY instead; one of the two
# per service, not both.
# PRIVACYFENCE_PEEK_BASE_URL=https://peek.example.com
# PRIVACYFENCE_GRIST_SERVER_URL=https://grist.example.com
# PRIVACYFENCE_GRIST_PROVISIONER_URL=https://grist-provisioner.example.com
# PRIVACYFENCE_PEEK_PROVISIONING_KEY_FILE=/run/secrets/peek_provisioning_key
# PRIVACYFENCE_GRIST_PROVISIONING_KEY_FILE=/run/secrets/grist_provisioning_key
