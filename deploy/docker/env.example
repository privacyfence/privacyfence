# Copy to .env next to compose.yaml (the Quick start in docs/org-mode-docker.md) and edit. Compose
# reads it for the values in compose.yaml; the daemon's own settings are in privacyfence.env.

# The public host name, with no https:// and no path, such as pf.acme.example.com. Caddy gets its
# certificate for it, and compose.yaml makes PRIVACYFENCE_ISSUER_URL https://<this>. Compose
# refuses to start without it.
PF_HOSTNAME=

# The image version: the release you fetched these files from. Pin X.Y in production (it follows
# that line's patch releases); a pre-release such as 7.0.0a1 has only its exact version as a tag.
PRIVACYFENCE_IMAGE_TAG=
