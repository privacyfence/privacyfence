# Copy to /opt/pf-qa/run/privacyfence.env on the host and fill in the blanks. No secret goes in
# this file: the IdP client secret is the idp_client_secret file next to it.
PRIVACYFENCE_ISSUER_URL=https://runner.privacyfence.eu

# The QA Google OIDC app.
PRIVACYFENCE_IDP_ISSUER=https://accounts.google.com
PRIVACYFENCE_IDP_CLIENT_ID=
PRIVACYFENCE_IDP_CLIENT_SECRET_FILE=/run/secrets/idp_client_secret

PRIVACYFENCE_ADMIN_EMAILS=test@privacyfence.eu

# The Caddy container only (172.30.87.2 in deploy/docker/compose.yaml).
PRIVACYFENCE_TRUSTED_PROXIES=172.30.87.2

PRIVACYFENCE_PEEK_BASE_URL=https://peek-qa.privacyfence.eu
PRIVACYFENCE_GRIST_SERVER_URL=https://docs.getgrist.com

# Show the services that are not released yet, so their accounts can be connected.
PRIVACYFENCE_PREVIEW_SERVICES=*
