# Credentials and secrets
credentials/*
!credentials/.gitkeep
org/*
.env
*.pem
*.key
*.p12
src/privacyfence/_telegram_credentials.py
scripts/dev_env.sh
# scripts/sync_room_directory.py's OAuth token for the admin-scoped Google
# Cloud project it syncs the room directory from -- dev-mode data_dir() is
# the repo root, same as the other credential paths above.
.room_sync_token.json

# User configuration (keep only the .example)
config/settings.yaml
config/settings.local.yaml

# The same user configuration/authority state as above, kept under its own
# subdirectory -- dev-mode data_dir() is the repo root, same reasoning as everything else here
# (paths.py's authority_dir()/authority_root()).
authority/

# ADR 0007: download_staging.py's/upload_staging.py's own per-principal
# staging directories -- same "dev-mode data_dir() is the repo root"
# reasoning as authority/ above. Only ever holds encrypted, short-lived
# ciphertext (see either module's own docstring), but there's no reason
# for it to sit in the working tree either. Anchored to the two places
# paths.py puts them (the local principal's data_dir() root, and
# users/<id>/ for every other principal), so the pattern does not also
# swallow cloudflare/downloads/, the download Worker's source.
/downloads/
/uploads/
/users/*/downloads/
/users/*/uploads/

# Local runtime caches (dev-mode data_dir() is the repo root -- see paths.py)
resource_name_cache.json
update_check_cache.json
# This install's own random id (daemon_main.get_or_create_deployment_id) --
# dev-mode data_dir() is the repo root, same as the caches above.
deployment_id
# Bootstrap-link discovery files (web/server.py's mint_bootstrap_url) --
# same dev-mode-data_dir()-is-the-repo-root reasoning as deployment_id above.
approvals_url
settings_url
# The handoff files a source daemon writes (paths.handoff_dir() is data_dir(), the repo root,
# here): mcp_url and web_base_url for discovery, and mcp_token, the agent's live bearer token.
/mcp_url
/mcp_token
/web_base_url

# QA fixture manifest (keep only the .example) -- reveals which real
# project/space/folder/calendar/list/channel/chat a QA environment uses,
# on which real accounts. See tests/fixtures/qa_environment.yaml.example.
tests/fixtures/qa_environment.yaml

# Claude Code
.claude/*
# ...except the shared project config checked in for the whole team. settings.json alone was not
# enough: its SessionStart entry points at .claude/hooks/session-start.sh, which `.claude/*` was
# still excluding -- so the hook was configured and then never shipped. A directory has to be
# re-included before anything under it can be, hence the trailing slashes.
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
!.claude/commands/
# Still ignored, deliberately: settings.local.json (per-machine overrides) and everything else
# Claude Code writes into .claude/ as session state.

# Lock files
*.lock

# Python
*.pyc
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Node (mcpb/shim/, cloudflare/downloads/)
node_modules/
*.tsbuildinfo
env/
.wrangler/

# Test / coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json
.pytest_cache/
.mypy_cache/
.ruff_cache/
# tests/integration/test_browser_smoke.py's own failure-artifact capture
# (screenshot/DOM/console/daemon log) -- written lazily, only on a failing
# run, never something to commit.
test-results/

# Logs
*.log
logs/

# macOS
.DS_Store
*.dmg
*.mcpb

# IDE
.idea/
.vscode/
