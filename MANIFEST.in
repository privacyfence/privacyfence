# The Telegram app credentials module is git-ignored (generated at build time from CI secrets by
# scripts/telegram_credentials.py), and setuptools_scm's file finder only packages tracked files,
# so without this line it never reaches the sdist -- or the wheel, which `python -m build` builds
# from the sdist. Absent (a local build without the secrets), this matches nothing and is skipped.
# See ADR 0040.
include src/privacyfence/_telegram_credentials.py

# sync/ is the separate privacyfence-sync distribution, published from its own pyproject.toml.
# setuptools_scm's file finder packages every tracked file, so without this the privacyfence sdist
# would carry the whole sync/ tree.
prune sync

# plugins/ holds the privacyfence-sync Claude plugin (ADR 0163), attached to releases as a zip.
prune plugins
